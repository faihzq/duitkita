rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is the document owner
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper to check if user is a group admin
    function isGroupAdmin(groupId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.isAdmin == true;
    }

    // Helper to check if user is a group member
    function isGroupMember(groupId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Username reservations — the uniqueness index for handles.
    // The document id IS the lowercase handle, so creating it is the claim;
    // Firestore has no unique constraint, and a query-then-write would race.
    match /usernames/{handle} {
      // Anyone signed in can resolve a handle when adding a member/traveller.
      allow read: if isSignedIn();

      // You may only ever claim a handle for yourself.
      allow create: if isSignedIn() &&
                       request.resource.data.uid == request.auth.uid;

      // Re-claiming your own handle (same transaction rewrites it).
      allow update: if isSignedIn() &&
                       resource.data.uid == request.auth.uid &&
                       request.resource.data.uid == request.auth.uid;

      // Only the holder can release it, when changing to a new handle.
      // `resource == null` covers deleting a reservation that is already gone:
      // without it, a stale handle on a profile denies the whole rename.
      allow delete: if isSignedIn() &&
                       (resource == null ||
                        resource.data.uid == request.auth.uid);
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if isSignedIn() &&
                     request.auth.uid in resource.data.memberIds;

      allow create: if isSignedIn() &&
                       request.auth.uid == request.resource.data.createdBy;

      // Admin or creator can update group.
      // A plain member may also remove *themselves* — needed to leave a group
      // and for account deletion, which must not leave their uid behind. They
      // can touch nothing else, and cannot remove anyone but themselves.
      allow update: if isSignedIn() &&
                       (request.auth.uid == resource.data.createdBy ||
                        isGroupAdmin(groupId) ||
                        (request.auth.uid in resource.data.memberIds &&
                         !(request.auth.uid in request.resource.data.memberIds) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['memberIds', 'memberCount', 'updatedAt'])));

      allow delete: if isSignedIn() &&
                       request.auth.uid == resource.data.createdBy;

      // Members subcollection
      match /members/{memberId} {
        allow read: if isSignedIn() &&
                       request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        allow create: if isSignedIn() &&
                        (isGroupAdmin(groupId) ||
                         request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy);

        // Members can remove their own membership (leaving / account deletion).
        allow delete: if isSignedIn() &&
                        (isGroupAdmin(groupId) ||
                         request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy ||
                         request.auth.uid == memberId);

        // Admin/creator can update any member; members can update their own stats
        allow update: if isSignedIn() &&
                        (isGroupAdmin(groupId) ||
                         request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy ||
                         (request.auth.uid == memberId &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalPaid', 'paymentCount'])));
      }

      // Payments subcollection
      match /payments/{paymentId} {
        // Group members can read payments in their group
        allow read: if isSignedIn() && isGroupMember(groupId);

        // Members can submit their own payment; admins can submit for anyone (bulk import)
        allow create: if isSignedIn() &&
                         isGroupMember(groupId) &&
                         (request.auth.uid == request.resource.data.userId ||
                          isGroupAdmin(groupId));

        // Only group admin can verify/reject payments
        allow update: if isSignedIn() && isGroupAdmin(groupId);

        // Payment owner or admin can delete
        allow delete: if isSignedIn() &&
                         (request.auth.uid == resource.data.userId ||
                          isGroupAdmin(groupId));
      }
    }

    // Payments collection (stored top-level, not as a subcollection)
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        isGroupMember(resource.data.groupId)
      );
      allow create: if isSignedIn() &&
                       request.auth.uid == request.resource.data.userId &&
                       isGroupMember(request.resource.data.groupId);
      allow update: if isSignedIn() && isGroupAdmin(resource.data.groupId);
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        isGroupAdmin(resource.data.groupId)
      );
    }

    // Collection-group wildcard: lets users query their own payments across all groups
    // (used by payment history screen and home screen summaries)
    match /{path=**}/payments/{paymentId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // Collection-group wildcard: lets users query their own member docs across all groups
    // (used by getAdminGroupIdsStream to find groups where user is admin)
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // Expenses collection
    match /expenses/{expenseId} {
      allow read: if isSignedIn() &&
                     isGroupMember(resource.data.groupId);

      // Members can create expense requests for themselves
      allow create: if isSignedIn() &&
                       request.auth.uid == request.resource.data.requestedBy &&
                       isGroupMember(request.resource.data.groupId);

      // Only group admin can approve/reject expenses
      allow update: if isSignedIn() &&
                       isGroupAdmin(resource.data.groupId);

      // Requester or admin can delete
      allow delete: if isSignedIn() &&
                       (request.auth.uid == resource.data.requestedBy ||
                        isGroupAdmin(resource.data.groupId));
    }

    // Fund loans collection (money borrowed from a group's fund, repaid over time)
    match /fund_loans/{loanId} {
      allow read: if isSignedIn() &&
                     (request.auth.uid == resource.data.borrowerId ||
                      request.auth.uid == resource.data.createdBy ||
                      isGroupMember(resource.data.groupId));

      // Members create pending requests (recorded under their own uid).
      // Admins may create a pre-approved loan directly.
      allow create: if isSignedIn() &&
                       request.auth.uid == request.resource.data.createdBy &&
                       isGroupMember(request.resource.data.groupId) &&
                       (request.resource.data.status == 'pending' ||
                        (request.resource.data.status == 'approved' &&
                         isGroupAdmin(request.resource.data.groupId)));

      // Group admins can approve/reject and record repayments.
      // The borrower may only flip their own 'borrowerNotified' flag.
      allow update: if isSignedIn() &&
                       (isGroupAdmin(resource.data.groupId) ||
                        (request.auth.uid == resource.data.borrowerId &&
                         request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['borrowerNotified'])));

      // Requester (to cancel a pending request) or admin can delete.
      allow delete: if isSignedIn() &&
                       (request.auth.uid == resource.data.createdBy ||
                        isGroupAdmin(resource.data.groupId));
    }

    // Trips collection (day-by-day itineraries).
    // The organiser (createdBy) owns the plan and is the only one who may
    // change it; other travellers have read access.
    match /trips/{tripId} {
      function tripData() {
        return get(/databases/$(database)/documents/trips/$(tripId)).data;
      }

      function isTraveller() {
        return isSignedIn() && request.auth.uid in tripData().travellerIds;
      }

      function isOrganiser() {
        return isSignedIn() && request.auth.uid == tripData().createdBy;
      }

      allow read: if isSignedIn() &&
                     request.auth.uid in resource.data.travellerIds;

      // The creator must be on the trip they create.
      allow create: if isSignedIn() &&
                       request.auth.uid == request.resource.data.createdBy &&
                       request.auth.uid in request.resource.data.travellerIds;

      // Only the organiser can edit the trip. They may hand ownership to
      // someone already travelling — needed when deleting their account — but
      // never to an outsider, so it cannot be stolen or dumped on a stranger.
      // A traveller may additionally remove *themselves*, and nothing else.
      allow update: if isSignedIn() &&
                       ((request.auth.uid == resource.data.createdBy &&
                         (request.resource.data.createdBy == resource.data.createdBy ||
                          request.resource.data.createdBy in resource.data.travellerIds)) ||
                        (request.auth.uid in resource.data.travellerIds &&
                         !(request.auth.uid in request.resource.data.travellerIds) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['travellerIds', 'travellers', 'updatedAt'])));

      allow delete: if isSignedIn() &&
                       request.auth.uid == resource.data.createdBy;

      // Itinerary stops — travellers read, the organiser plans.
      match /stops/{stopId} {
        allow read: if isTraveller();
        allow create, update, delete: if isOrganiser();
      }
    }

    // App config (version check, feature flags)
    // Read: any authenticated user
    // Write: only via Firebase Console (no client writes)
    match /app_config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Matches collection (JDT matches - manual entries)
    // Read: any authenticated user
    // Write: only admins of any group (app-level feature, not group-specific)
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Debts collection (personal debt tracking)
    match /debts/{debtId} {
      allow read: if isSignedIn() &&
                     request.auth.uid == resource.data.userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == request.resource.data.userId;

      allow update, delete: if isSignedIn() &&
                               request.auth.uid == resource.data.userId;

      // Debt payments subcollection
      match /payments/{paymentId} {
        allow read, create, delete: if isSignedIn() &&
                                       request.auth.uid == get(/databases/$(database)/documents/debts/$(debtId)).data.userId;
      }
    }
  }
}
