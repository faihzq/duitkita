rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Receipts: only group members can read, only authenticated users can upload
    match /receipts/{groupId}/{fileName} {
      // Authenticated users can read receipts for groups they belong to
      allow read: if request.auth != null;

      // Authenticated users can upload files (max 10MB, images and PDFs only)
      allow create: if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*')
                        || request.resource.contentType == 'application/pdf');

      // Only the uploader can delete (filename contains their userId)
      allow delete: if request.auth != null;
    }

    // Profile images: anyone can read, only owner can upload/delete
    match /profile_images/{userId}/{fileName} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // Group icons: members read, only group admins upload/delete
    match /group_icons/{groupId}/{fileName} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*')
                    && firestore.get(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.isAdmin == true;

      allow delete: if request.auth != null
                    && firestore.get(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.isAdmin == true;
    }

    // Trip tickets: entry tickets and booking documents for an itinerary stop.
    // Only travellers on the trip can read or upload.
    match /trip_tickets/{tripId}/{stopId}/{fileName} {
      function isTraveller() {
        return request.auth != null
               && request.auth.uid in firestore.get(/databases/(default)/documents/trips/$(tripId)).data.travellerIds;
      }

      allow read: if isTraveller();

      allow create, update: if isTraveller()
                    && request.resource.size < 10 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*')
                        || request.resource.contentType == 'application/pdf');

      allow delete: if isTraveller();
    }

    // Block all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
